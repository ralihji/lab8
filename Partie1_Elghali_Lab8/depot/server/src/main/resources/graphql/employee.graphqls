# Schéma GraphQL des employés (SEG3502, laboratoire 8).
# Les noms, arguments et champs suivent exactement les opérations du client
# Angular fourni : client/src/app/service/employee.service.ts

type Query {
    # Liste de tous les employés (requête GET_EMPLOYEES du client)
    employees: [Employee]
}

type Employee {
    id: ID!
    name: String!
    dateOfBirth: String!
    city: String!
    salary: Float!
    gender: String
    email: String
}

# Données du formulaire du client. Les champs sont facultatifs dans le schéma,
# comme CreateEmployeeInput.kt : le résolveur vérifie les champs obligatoires.
input CreateEmployeeInput {
    name: String
    dateOfBirth: String
    city: String
    salary: Float
    gender: String
    email: String
}

type Mutation {
    # Ajout d'un employé (mutation ADD_EMPLOYEE du client) ; renvoie l'employé enregistré
    newEmployee(createEmployeeInput: CreateEmployeeInput!): Employee!
}
